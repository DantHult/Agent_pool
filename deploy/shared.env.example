# Invite-only shared server. Copy locally to an owner-only file; no real secrets here.
RELAY_AUTH_MODE=invite
RELAY_PUBLIC_URL=https://relay.example.com
RELAY_DATA_DIR=/var/lib/relay
RELAY_SESSION_TTL_SECONDS=28800
RELAY_SESSION_IDLE_SECONDS=1800
# Local native subscription profiles are never used by shared mode.
RELAY_ENABLE_NATIVE=0
# Enable only after separately provisioning deploy/compose.yaml and the Codex image.
RELAY_ENABLE_ORG_API=0
RELAY_ORG_OPENAI_API_KEY=
RELAY_CODEX_PROXY_TOKEN=
RELAY_CODEX_IMAGE=relay-codex:local
RELAY_CODEX_NETWORK=relay-codex-internal
RELAY_CODEX_PROXY_URL=http://relay-codex-proxy:8080/v1
RELAY_CODEX_MODEL=
RELAY_CODEX_TIMEOUT_SECONDS=180
