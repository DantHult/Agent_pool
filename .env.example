# Shared invite-only CLI defaults. Use --auth demo explicitly for the local demo.
RELAY_DATA_DIR=data
RELAY_AUTH_MODE=invite
RELAY_PUBLIC_URL=https://relay.example.com
RELAY_SESSION_TTL_SECONDS=28800
RELAY_SESSION_IDLE_SECONDS=1800

# Native macOS Codex App Server, using each local profile's ChatGPT login.
# The web dashboard requires --auth local-owner --backend native and an offline owner pin.
RELAY_ENABLE_NATIVE=0
RELAY_NATIVE_ROOT=.relay-native
# Legacy standalone CLI owner only; the local-owner dashboard uses its offline database pin.
RELAY_NATIVE_OWNER=alice
RELAY_CODEX_BIN=codex
# Optional; otherwise Codex selects the profile's available default model.
RELAY_NATIVE_MODEL=
RELAY_NATIVE_TIMEOUT_SECONDS=180
# Explicit opt-in test only; consumes the signed-in accounts' Codex allowance.
RELAY_RUN_NATIVE_SMOKE=0

# Optional organization API execution. Keep these on the server only.
# Leave disabled for the deterministic credential-free hackathon demo.
RELAY_ENABLE_ORG_API=0
RELAY_ORG_OPENAI_API_KEY=
# Generate a random token in a secret manager and supply the same value to the proxy/server.
RELAY_CODEX_PROXY_TOKEN=
RELAY_CODEX_IMAGE=relay-codex:local
RELAY_CODEX_NETWORK=relay-codex-internal
RELAY_CODEX_PROXY_URL=http://relay-codex-proxy:8080/v1
# Choose a Codex model enabled for your organization's API project.
RELAY_CODEX_MODEL=
RELAY_CODEX_TIMEOUT_SECONDS=180
# Official Codex request/stream retries only. Entire coding turns are never replayed automatically.
RELAY_CODEX_REQUEST_RETRIES=2
RELAY_CODEX_STREAM_RETRIES=1
# Opt-in paid integration test only; leave unset for normal CI.
RELAY_RUN_LIVE_SMOKE=0
