# Build locally; the runtime never pulls arbitrary images during a task.
FROM node:22-bookworm-slim
ARG CODEX_VERSION=0.163.0
RUN apt-get update && apt-get install -y --no-install-recommends git python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global @openai/codex@${CODEX_VERSION}
COPY deploy/limit_exec.py /opt/relay/limit_exec.py
COPY deploy/result.schema.json /opt/relay/result.schema.json
WORKDIR /workspace
# UID/GID are overridden to the workspace owner by Relay's runner.
USER node
ENTRYPOINT ["python3", "-I", "/opt/relay/limit_exec.py"]
CMD ["codex", "--version"]
