# Core local demo. The app does not automatically load this file.
RELAY_DATA_DIR=data
RELAY_AUTH_MODE=demo

# Optional organization API execution. Keep these on the server only.
# Leave disabled for the deterministic credential-free hackathon demo.
RELAY_ENABLE_ORG_API=0
RELAY_ORG_OPENAI_API_KEY=
# Generate a random token in a secret manager and supply the same value to the proxy/server.
RELAY_CODEX_PROXY_TOKEN=
RELAY_CODEX_IMAGE=relay-codex:local
RELAY_CODEX_NETWORK=relay-codex-internal
RELAY_CODEX_PROXY_URL=http://relay-codex-proxy:8080/v1
# Choose a Codex model enabled for your organization's API project.
RELAY_CODEX_MODEL=
RELAY_CODEX_TIMEOUT_SECONDS=180
# Official Codex request/stream retries only. Entire coding turns are never replayed automatically.
RELAY_CODEX_REQUEST_RETRIES=2
RELAY_CODEX_STREAM_RETRIES=1
# Opt-in paid integration test only; leave unset for normal CI.
RELAY_RUN_LIVE_SMOKE=0
